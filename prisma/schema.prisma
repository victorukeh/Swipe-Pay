// Operation Borderless data model.
//
// Two rules shape everything below: money is a BigInt count of minor units
// (no Decimal, no Float, anywhere), and the ledger is append-only and
// double-entry -- `balances` is a projection that must always equal the sum
// of a wallet's signed `ledger_entries`, and `transactions` only ever
// contains committed money (failures live in `transaction_attempts`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The supported mock stablecoins, and the sole authority for which ones
/// exist. A table rather than an enum, so a new stablecoin is an INSERT and
/// not a release -- at the cost of compile-time exhaustiveness, pushed to a
/// runtime check in CurrencyRegistry.
model Currency {
  /// Ticker as clients send it, e.g. "cNGN".
  code      String  @id
  /// ISO-4217 code of the fiat currency this stablecoin tracks 1:1.
  peg       String
  /// Decimal places admitted (0 for cXAF, 6 for USDx). Immutable once any
  /// balance or ledger entry references the currency -- enforced by trigger,
  /// since changing it would silently reinterpret every amount stored.
  decimals  Int
  name      String
  /// Display name of the smallest unit, e.g. "kobo".
  minorUnit String  @map("minor_unit")
  /// Lets a currency be withdrawn from new operations without deleting history.
  isActive  Boolean @default(true) @map("is_active")
  /// Fractional index controlling display order, so a new currency slots in
  /// at `(left + right) / 2` without renumbering. NUMERIC, not float -- a
  /// float midpoint eventually collides and ordering goes non-deterministic.
  sortOrder Decimal @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  balances           Balance[]
  ledgerEntries      LedgerEntry[]
  sourceTransactions Transaction[] @relation("TransactionSourceCurrency")
  destTransactions   Transaction[] @relation("TransactionDestCurrency")

  @@index([isActive, sortOrder])
  @@map("currencies")
}

enum TransactionType {
  DEPOSIT
  SWAP
  TRANSFER
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

/// Which tier priced a transaction. Surfaced on every transaction and on
/// GET /rates, so a caller can tell a live rate from a degraded one.
enum RateSource {
  LIVE /// freshly fetched from the upstream provider
  CACHED /// served from Redis within its TTL
  STALE /// provider unavailable; last-known-good from fx_rate_snapshots
  FALLBACK /// provider unavailable and no snapshot; committed static table
  PEGGED /// same-currency conversion; rate is exactly 1
}

enum AttemptOutcome {
  SUCCEEDED
  FAILED
}

enum IdempotencyState {
  IN_FLIGHT
  COMPLETED
  FAILED
}

/// A virtual multi-currency wallet, identified by email or phone -- at least
/// one is required and neither may be reused (unique indexes below).
model Wallet {
  id        String   @id @db.Uuid
  email     String?  @unique
  phone     String?  @unique
  /// Internal clearing accounts are excluded from the public API.
  isSystem  Boolean  @default(false) @map("is_system")
  /// Stable handle for internal wallets so a seed is idempotent.
  systemKey String?  @unique @map("system_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  credential           Credential?
  balances             Balance[]
  ledgerEntries        LedgerEntry[]
  sentTransactions     Transaction[]        @relation("TransactionSource")
  receivedTransactions Transaction[]        @relation("TransactionDestination")
  attempts             TransactionAttempt[]

  @@map("wallets")
}

/// Split out of Wallet so no balance query ever loads a password hash.
model Credential {
  walletId     String   @id @map("wallet_id") @db.Uuid
  passwordHash String   @map("password_hash")
  salt         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

/// One row per (wallet, currency) -- the row `SELECT ... FOR UPDATE` locks
/// during a money movement, in deterministic order, so concurrent debits
/// cannot overdraw and opposing transfers cannot deadlock.
model Balance {
  walletId      String   @map("wallet_id") @db.Uuid
  currency      String
  /// Minor units. Never negative for customer wallets (app check + CHECK constraint).
  amount        BigInt   @default(0)
  /// True only for clearing accounts, which legitimately run negative
  /// (SYSTEM_MINT by total issued supply, SYSTEM_FX by whatever it's paying out).
  allowNegative Boolean  @default(false) @map("allow_negative")
  updatedAt     DateTime @updatedAt @map("updated_at")

  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  currencyRef Currency @relation(fields: [currency], references: [code])

  @@id([walletId, currency])
  @@index([currency])
  @@map("balances")
}

/// A committed money movement: sender, receiver, source/dest amount and
/// currency, the rate applied, and a timestamp.
model Transaction {
  id String @id @db.Uuid

  type TransactionType

  /// For a DEPOSIT this is the credited wallet. For a SWAP, source == dest.
  sourceWalletId String  @map("source_wallet_id") @db.Uuid
  destWalletId   String? @map("dest_wallet_id") @db.Uuid

  sourceCurrency String @map("source_currency")
  sourceAmount   BigInt @map("source_amount")
  destCurrency   String @map("dest_currency")
  destAmount     BigInt @map("dest_amount")

  /// Scaled by MoneyUtil.RATE_SCALE (1e12): 1 USD = 1612.45 NGN -> 1612450000000000.
  rateScaled BigInt     @map("rate_scaled")
  rateSource RateSource @map("rate_source")
  rateAsOf   DateTime   @map("rate_as_of")

  idempotencyKey String?  @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  sourceWallet      Wallet   @relation("TransactionSource", fields: [sourceWalletId], references: [id])
  destWallet        Wallet?  @relation("TransactionDestination", fields: [destWalletId], references: [id])
  sourceCurrencyRef Currency @relation("TransactionSourceCurrency", fields: [sourceCurrency], references: [code])
  destCurrencyRef   Currency @relation("TransactionDestCurrency", fields: [destCurrency], references: [code])

  entries  LedgerEntry[]
  attempts TransactionAttempt[]

  @@index([sourceWalletId, createdAt(sort: Desc)])
  @@index([destWalletId, createdAt(sort: Desc)])
  @@map("transactions")
}

/// Double-entry, append-only: every transaction writes balanced pairs, so
/// the signed sum per currency is always zero, with clearing accounts as
/// the counterparty for deposits and cross-currency legs. Querying history
/// over entries (not transactions) is what makes one transfer read as
/// "sent" for the sender and "received" for the receiver without
/// duplication.
model LedgerEntry {
  id            String          @id @db.Uuid
  transactionId String          @map("transaction_id") @db.Uuid
  walletId      String          @map("wallet_id") @db.Uuid
  currency      String
  direction     LedgerDirection
  /// Always positive; `direction` carries the sign.
  amount        BigInt
  /// Balance immediately after this entry, assigned by the
  /// `ledger_entries_apply_to_balance` trigger -- never by the caller.
  balanceAfter  BigInt          @default(0) @map("balance_after")
  createdAt     DateTime        @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  wallet      Wallet      @relation(fields: [walletId], references: [id])
  currencyRef Currency    @relation(fields: [currency], references: [code])

  @@index([walletId, createdAt(sort: Desc), id])
  @@index([walletId, currency])
  @@index([transactionId])
  @@map("ledger_entries")
}

/// Append-only attempt log, successes and failures both. A failed attempt is
/// written on a fresh connection after rollback, since a row inside the
/// doomed transaction would disappear with it.
model TransactionAttempt {
  id             String          @id @db.Uuid
  walletId       String          @map("wallet_id") @db.Uuid
  type           TransactionType
  outcome        AttemptOutcome
  /// SHA-256 of the canonicalised request body.
  requestHash    String          @map("request_hash")
  idempotencyKey String?         @map("idempotency_key")
  transactionId  String?         @map("transaction_id") @db.Uuid
  errorCode      String?         @map("error_code")
  errorMessage   String?         @map("error_message")
  /// Correlation id echoed to the client in the error envelope.
  requestId      String          @map("request_id")
  createdAt      DateTime        @default(now()) @map("created_at")

  wallet      Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt(sort: Desc), id])
  @@index([outcome])
  @@map("transaction_attempts")
}

/// In Postgres, not Redis: the claim must be transactional with the ledger
/// write, or a key claimed outside it could outlive a rollback and poison
/// the operation permanently.
model IdempotencyRecord {
  /// Route-level namespace, e.g. "POST /v1/transfers".
  scope String
  key   String

  walletId String @map("wallet_id") @db.Uuid

  /// SHA-256 of the canonicalised body. A replay with a different body is
  /// rejected, not silently served.
  requestHash String @map("request_hash")

  state IdempotencyState

  /// Replayed verbatim on retry. Stored for successes and deterministic 4xx
  /// failures; never for transient 5xx, where the key is released instead.
  responseStatus Int?    @map("response_status")
  responseBody   Json?   @map("response_body")
  transactionId  String? @map("transaction_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([scope, key])
  @@index([walletId])
  @@map("idempotency_records")
}

/// Last-known-good FX rates, so a provider outage survives a restart. Redis
/// is only a TTL cache in front of this.
model FxRateSnapshot {
  base       String
  quote      String
  rateScaled BigInt   @map("rate_scaled")
  source     String
  fetchedAt  DateTime @map("fetched_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([base, quote])
  @@map("fx_rate_snapshots")
}
