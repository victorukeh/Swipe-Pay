// Cardtonic data model.
//
// Two rules shape everything below:
//
//  1. Money is an integer. Every amount is a BigInt count of a currency's minor
//     units (kobo, pesewa, micro-dollar...). There is no Decimal and no Float
//     anywhere in this schema, so no rounding can be introduced by storage.
//
//  2. The ledger is append-only and double-entry. `balances` is a projection
//     that must always equal the sum of a wallet's signed `ledger_entries`;
//     `transactions` and `ledger_entries` only ever contain committed, successful
//     money. Failed attempts live in `transaction_attempts` instead, so the
//     ledger invariant stays provable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The five supported mock stablecoins. Each is pegged 1:1 to a fiat currency;
/// the peg and the number of decimal places live in src/money/currencies.ts.
enum Currency {
  cNGN
  cGHS
  cXAF
  USDx
  EURx
}

enum TransactionType {
  DEPOSIT
  SWAP
  TRANSFER
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

/// Why a given rate was used. Surfaced on every transaction and on GET /rates so
/// a caller can always tell whether their conversion used a live rate or a
/// degraded one.
enum RateSource {
  LIVE /// freshly fetched from the upstream provider
  CACHED /// served from Redis within its TTL
  STALE /// provider unavailable; last-known-good from fx_rate_snapshots
  FALLBACK /// provider unavailable and no snapshot; committed static table
  PEGGED /// same-currency conversion; rate is exactly 1
}

enum AttemptOutcome {
  SUCCEEDED
  FAILED
}

enum IdempotencyState {
  IN_FLIGHT
  COMPLETED
  FAILED
}

/// A virtual multi-currency wallet. Identified by email or mobile number — at
/// least one is required and neither may be reused (enforced by unique indexes
/// below, not by application code).
model Wallet {
  id        String   @id @db.Uuid
  email     String?  @unique
  phone     String?  @unique
  /// Internal wallets (currently only SYSTEM_ROUNDING) are excluded from the
  /// public API and cannot be authenticated against.
  isSystem  Boolean  @default(false) @map("is_system")
  /// Stable handle for internal wallets so a seed is idempotent.
  systemKey String?  @unique @map("system_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  credential           Credential?
  balances             Balance[]
  ledgerEntries        LedgerEntry[]
  sentTransactions     Transaction[]        @relation("TransactionSource")
  receivedTransactions Transaction[]        @relation("TransactionDestination")
  attempts             TransactionAttempt[]

  @@map("wallets")
}

/// Split out of Wallet deliberately: a wallet is a money container, a credential
/// is an authentication artefact. Keeping them apart means no balance query ever
/// loads a password hash.
model Credential {
  walletId     String   @id @map("wallet_id") @db.Uuid
  passwordHash String   @map("password_hash")
  salt         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

/// One row per (wallet, currency). This is the row that gets SELECT ... FOR UPDATE
/// locked during every money movement, in a deterministic order, so concurrent
/// debits cannot overdraw and two opposing transfers cannot deadlock.
model Balance {
  walletId  String   @map("wallet_id") @db.Uuid
  currency  Currency
  /// Minor units. Never negative for customer wallets — guarded in the
  /// application and by a CHECK constraint added in the migration.
  amount    BigInt   @default(0)
  /// True only for internal clearing accounts. A clearing account legitimately
  /// carries a negative (credit) position: SYSTEM_MINT goes negative by the total
  /// supply it has issued, and SYSTEM_FX goes negative in whichever currency it is
  /// currently paying out. Customer balances are never allowed to.
  allowNegative Boolean @default(false) @map("allow_negative")
  updatedAt DateTime @updatedAt @map("updated_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@id([walletId, currency])
  @@map("balances")
}

/// A committed money movement. Contains everything the brief asks a transfer to
/// record: sender, receiver, source amount and currency, destination amount and
/// currency, the rate applied and a timestamp.
model Transaction {
  id String @id @db.Uuid

  type TransactionType

  /// For a DEPOSIT this is the credited wallet and `sourceAmount` equals
  /// `destAmount`. For a SWAP source and destination are the same wallet.
  sourceWalletId String  @map("source_wallet_id") @db.Uuid
  destWalletId   String? @map("dest_wallet_id") @db.Uuid

  sourceCurrency Currency @map("source_currency")
  sourceAmount   BigInt   @map("source_amount")
  destCurrency   Currency @map("dest_currency")
  destAmount     BigInt   @map("dest_amount")

  /// The applied rate, scaled by MoneyUtil.RATE_SCALE (1e12), as an integer.
  /// 1 USD = 1612.45 NGN is stored as 1612450000000000.
  rateScaled BigInt     @map("rate_scaled")
  rateSource RateSource @map("rate_source")
  /// When the rate used here was last refreshed upstream.
  rateAsOf   DateTime   @map("rate_as_of")

  idempotencyKey String?  @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  sourceWallet Wallet  @relation("TransactionSource", fields: [sourceWalletId], references: [id])
  destWallet   Wallet? @relation("TransactionDestination", fields: [destWalletId], references: [id])

  entries  LedgerEntry[]
  attempts TransactionAttempt[]

  @@index([sourceWalletId, createdAt(sort: Desc)])
  @@index([destWalletId, createdAt(sort: Desc)])
  @@map("transactions")
}

/// Double-entry, append-only.
///
/// Every transaction writes balanced pairs, so the signed sum of all entries in
/// any one currency is exactly zero — including deposits and cross-currency
/// conversions, which is only possible because the counter-leg goes to an
/// internal clearing account:
///
///   DEPOSIT              SYSTEM_MINT debit  -> user credit
///   TRANSFER (same ccy)  sender debit       -> receiver credit
///   SWAP / TRANSFER      user debit (src)   -> SYSTEM_FX credit (src)
///   (cross-currency)     SYSTEM_FX debit (dst) -> receiver credit (dst)
///
/// A wallet's history is a query over this table, which is why a single transfer
/// row reads correctly as "sent" for one wallet and "received" for the other
/// without being duplicated.
model LedgerEntry {
  id            String          @id @db.Uuid
  transactionId String          @map("transaction_id") @db.Uuid
  walletId      String          @map("wallet_id") @db.Uuid
  currency      Currency
  direction     LedgerDirection
  /// Always positive; `direction` carries the sign.
  amount        BigInt
  /// The wallet's balance in this currency immediately after this entry was
  /// applied. Makes the ledger auditable without replaying it from zero.
  balanceAfter  BigInt          @map("balance_after")
  createdAt     DateTime        @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  wallet      Wallet      @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt(sort: Desc), id])
  @@index([walletId, currency])
  @@index([transactionId])
  @@map("ledger_entries")
}

/// Append-only attempt log. Written on a separate connection *after* a failed
/// operation has rolled back, because a row inserted inside the doomed
/// transaction would disappear with it. Successful attempts are recorded too, so
/// this is a complete audit trail rather than just a failure log.
model TransactionAttempt {
  id             String          @id @db.Uuid
  walletId       String          @map("wallet_id") @db.Uuid
  type           TransactionType
  outcome        AttemptOutcome
  /// SHA-256 of the canonicalised request body. Lets an operator see that two
  /// attempts were the same request without storing the request itself.
  requestHash    String          @map("request_hash")
  idempotencyKey String?         @map("idempotency_key")
  /// Set when the attempt succeeded.
  transactionId  String?         @map("transaction_id") @db.Uuid
  /// Set when it failed, e.g. INSUFFICIENT_FUNDS.
  errorCode      String?         @map("error_code")
  errorMessage   String?         @map("error_message")
  /// Correlation id echoed to the client in the error envelope.
  requestId      String          @map("request_id")
  createdAt      DateTime        @default(now()) @map("created_at")

  wallet      Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt(sort: Desc), id])
  @@index([outcome])
  @@map("transaction_attempts")
}

/// Idempotency lives in Postgres rather than Redis because the claim has to be
/// transactional with the ledger write — a key claimed in Redis could survive a
/// database rollback and permanently poison the operation.
model IdempotencyRecord {
  /// Route-level namespace, e.g. "POST /v1/transfers". The same key may be used
  /// on two different endpoints without colliding.
  scope String
  key   String

  walletId String @map("wallet_id") @db.Uuid

  /// SHA-256 of the canonicalised request body. A replay with the same key but a
  /// different body is a client bug and is rejected, not silently served.
  requestHash String @map("request_hash")

  state IdempotencyState

  /// The original response, replayed verbatim on retry. Stored for successes and
  /// for deterministic 4xx failures (which would fail identically anyway); never
  /// for transient 5xx failures, where the key is released so a retry can work.
  responseStatus Int?    @map("response_status")
  responseBody   Json?   @map("response_body")
  transactionId  String? @map("transaction_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([scope, key])
  @@index([walletId])
  @@map("idempotency_records")
}

/// Last-known-good FX rates, persisted so a provider outage survives a restart.
/// Redis is only a TTL cache in front of this; if Redis is empty and the provider
/// is down, these rows are what keep swaps and transfers working.
model FxRateSnapshot {
  base       String
  quote      String
  /// Scaled by MoneyUtil.RATE_SCALE (1e12).
  rateScaled BigInt   @map("rate_scaled")
  source     String
  fetchedAt  DateTime @map("fetched_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([base, quote])
  @@map("fx_rate_snapshots")
}
