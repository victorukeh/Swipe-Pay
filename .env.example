# ---- API ----
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# ---- PostgreSQL ----
# docker compose supplies this automatically; set it only for local (non-Docker) runs.
DATABASE_URL=postgresql://borderless:borderless@localhost:5432/borderless?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Change these. 32+ chars. Separate secrets so an access token can never be replayed as a refresh token.
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# scrypt parameters for new credentials. Raising PASSWORD_KEY_LENGTH only affects
# newly written credentials: verify() takes the length from the stored hash, so
# existing logins keep working across a change.
PASSWORD_KEY_LENGTH=64
PASSWORD_SALT_BYTES=16

# ---- FX ----
# Live provider. Free, no API key required. Leave blank to force the fallback chain.
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
FX_PROVIDER_TIMEOUT_MS=4000
# How long a fetched rate is served from Redis before refetching.
FX_CACHE_TTL_SECONDS=300
# How stale a DB snapshot may be before it is reported as `stale` rather than `cached`.
FX_SNAPSHOT_MAX_AGE_SECONDS=86400

# ---- Tests ----
# Optional. When both are set, `yarn test` uses these instead of starting its own
# throwaway containers. They must point at DISPOSABLE instances: the suite drops
# the Redis database and writes freely to the schema.
# TEST_DATABASE_URL=postgresql://borderless:borderless@localhost:5432/borderless_test?schema=public
# TEST_REDIS_URL=redis://localhost:6379
